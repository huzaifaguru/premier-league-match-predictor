__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.claude/

# raw/processed data is re-downloadable/re-buildable, no need to version it
data/raw/*.csv
data/processed/*.parquet
data/processed/*.csv

# local artifacts: serialized model binaries only. best_params.json and
# the *_tuning_results.csv files are small, human-readable, and are the
# actual evidence behind the README's hyperparameter claims, so they're
# versioned rather than ignored.
*.log
models/*.pkl
models/*.joblib
.pytest_cache/
.coverage


# ...except the small serving model the Streamlit app loads on startup
# (regenerate with `python -m src.app_model`).
!models/app_model.joblib
